generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  phone            String           @unique
  name             String
  passwordHash     String
  rut              String?          @unique
  birthDate        DateTime?
  address          String?
  idFrontUrl       String?
  idBackUrl        String?
  isVerified       Boolean          @default(false)
  paymentMethod    String?
  mpCardToken      String?
  role             String           @default("passenger")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  selfieUrl        String?
  ratings          Rating[]         @relation("PassengerRatings")
  trips            Trip[]           @relation("PassengerTrips")
  reservasAsiento  ReservaAsiento[] @relation("PasajeroReservas")

  @@map("users")
}

model Driver {
  id                  String           @id @default(cuid())
  email               String           @unique
  phone               String           @unique
  name                String
  passwordHash        String
  rut                 String           @unique
  birthDate           DateTime
  address             String
  idFrontUrl          String
  idBackUrl           String
  selfieUrl           String?
  licenseNumber       String
  licenseUrl          String
  vehicleBrand        String
  vehicleModel        String
  vehicleYear         Int
  vehiclePlate        String           @unique
  vehiclePhotoUrl     String
  tagNumber           String
  status              String           @default("pending")
  membershipPaid      Boolean          @default(false)
  membershipPlan      String           @default("PREPAID")
  membershipProgress  Int              @default(0)
  membershipGoal      Int              @default(100000)
  dailyCashTripsCount Int              @default(0)
  membershipDate      DateTime?
  mpSubscriptionId    String?
  membershipExpiresAt DateTime?
  walletBalance       Int              @default(0)
  adminNotes          String?
  mercadoPagoLink     String?          // Link directo MercadoPago
  telefonoRutPay      String?          // Teléfono o RUT para pago con RutPay BancoEstado
  isOnline            Boolean          @default(false)
  lastLat             Float?
  lastLng             Float?
  lastSeen            DateTime?
  totalRating         Float            @default(0)
  totalTrips          Int              @default(0)
  bankName            String?
  bankAccountType     String?
  bankAccountNumber   String?
  bankAccountName     String?
  bankAccountRut      String?
  bankAccountEmail    String?

  // Datos específicos del colectivo en español
  lineaId             String?
  linea               LineaColectivo?  @relation(fields: [lineaId], references: [id])
  asientosTotales     Int              @default(4)
  asientosOcupados    Int              @default(0)
  sentidoRuta         String           @default("ida") // "ida" | "vuelta" | "regreso"
  folioRuta           String?          // Folio asignado al conductor (ej: "233012")
  mttValidada         Boolean          @default(false) // Si la patente fue confirmada en apps.mtt.cl
  mttFechaValidacion  DateTime?
  mttDetalle          String?          // JSON o texto de respuesta del Registro Nacional MTT

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  payouts             Payout[]
  ratings             Rating[]         @relation("DriverRatings")
  trips               Trip[]           @relation("DriverTrips")
  reservasAsiento     ReservaAsiento[] @relation("ConductorReservas")

  @@map("drivers")
}

model LineaColectivo {
  id                  String            @id @default(cuid())
  nombre              String            // ej: "Línea 233012 - Recorrido T"
  codigo              String            @unique // ej: "233012" o "T"
  folio               String?           // Folio oficial MTT (ej: "233012")
  region              Int?              // Región (ej: 13 RM)
  tipoServicio        String?           // "AUTOMOVIL URBANO TAXI COLECTIVO"
  nombreRecorrido     String?           // "T"
  tipoTrazado         String?           // "PRINCIPAL" | "ALTERNATIVO"
  comunas             String?           // "La Granja, La Pintana, La Florida"
  descripcion         String?           // "La Granja - La Pintana - La Florida (Metro Bellavista)"
  color               String            @default("#FACC15") // Amarillo colectivo distintivo
  tarifa              Int               @default(800) // Tarifa estándar CLP
  tarifaNoche         Int?              // Tarifa nocturna opcional CLP
  puntosRuta          String?           // JSON con array de coordenadas [lat, lng] del trazado de IDA
  puntosRutaRegreso   String?           // JSON con array de coordenadas [lat, lng] del trazado de REGRESO
  callesIda           String?           // Secuencia textual de calles de IDA
  callesRegreso       String?           // Secuencia textual de calles de REGRESO
  origen              String?           // Cabecera IDA: "Los Pensamientos (La Granja)"
  destino             String?           // Destino IDA: "Serafín Zamora (La Florida)"
  activa              Boolean           @default(true)
  fechaCreacion       DateTime          @default(now())
  fechaActualizacion  DateTime          @updatedAt
  conductores         Driver[]
  paradas             ParadaColectivo[]
  tramos              RouteSegment[]
  trazados            RouteShape[]
  reservas            ReservaAsiento[]

  @@map("lineas_colectivo")
}

model RouteSegment {
  id                 String         @id @default(cuid())
  lineaId            String         @map("linea_id")
  folio              String
  sentido            String         // "ida" | "regreso"
  orden              Int            // Orden estricto del Excel: 1, 2, 3...
  calleOriginal      String         @map("calle_original")
  calleNormalizada   String         @map("calle_normalizada")
  comuna             String
  latInicio          Float?         @map("lat_inicio")
  lngInicio          Float?         @map("lng_inicio")
  latFin             Float?         @map("lat_fin")
  lngFin             Float?         @map("lng_fin")
  geojson            Json?
  confianza          Float          @default(100.0)
  estadoValidacion   String         @default("PENDIENTE") @map("estado_validacion") // "PENDIENTE", "VALIDADO", "PUBLICADO", "REQUIERE_REVISION", "FALLIDO"
  notasValidacion    String?        @map("notas_validacion")
  metadatos          Json?
  fechaCreacion      DateTime       @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime       @updatedAt @map("fecha_actualizacion")

  linea              LineaColectivo @relation(fields: [lineaId], references: [id], onDelete: Cascade)

  @@index([lineaId, sentido, orden])
  @@index([folio, sentido, orden])
  @@index([estadoValidacion])
  @@map("route_segments")
}

model RouteShape {
  id                 String         @id @default(cuid())
  lineaId            String         @map("linea_id")
  folio              String
  sentido            String         // "ida" | "regreso"
  shapeId            String         @map("shape_id") // ej: "SHP-233012-IDA-v1"
  version            Int            @default(1)
  origenTipo         String         @default("RUTEADO_OSM") @map("origen_tipo") // "OFICIAL", "RUTEADO_OSM", "MAP_MATCHED", "MANUAL", "IMPORTADO"
  proveedorOrigen    String?        @map("proveedor_origen") // "OSRM", "MTT", "GTFS"
  versionOrigen      String?        @map("version_origen")
  distanciaMetros    Float?         @map("distancia_metros") // Calculado con ST_Length(geom::geography) en PostGIS
  confianza          Float          @default(100.0)
  estadoValidacion   String         @default("PENDIENTE") @map("estado_validacion") // "PENDIENTE", "VALIDADO", "PUBLICADO", "REQUIERE_REVISION", "FALLIDO"
  notasValidacion    String?        @map("notas_validacion")
  puntos             Json?          // Array derivado [[lat, lng], ...] para consumo rápido en frontend a 60fps
  limites            Json?          // Bounding box [minLng, minLat, maxLng, maxLat]
  esActivo           Boolean        @default(true) @map("es_activo")
  metadatos          Json?
  fechaCreacion      DateTime       @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime       @updatedAt @map("fecha_actualizacion")

  linea              LineaColectivo @relation(fields: [lineaId], references: [id], onDelete: Cascade)

  @@index([lineaId, sentido, esActivo])
  @@index([folio, sentido, esActivo])
  @@index([shapeId])
  @@index([estadoValidacion])
  @@map("route_shapes")
}

model CacheSegmentoVial {
  id                 String         @id @default(cuid())
  calleNormalizada   String         @map("calle_normalizada")
  comuna             String
  comunaVerificada   String?        @map("comuna_verificada")
  nombreVialResuelto String?        @map("nombre_vial_resuelto")
  osmWayId           String?        @map("osm_way_id")
  roadId             String?        @map("road_id")
  sentidoVial        String?        @map("sentido_vial")
  metodoResolucion   String         @default("OVERPASS_OSM") @map("metodo_resolucion")
  proveedor          String         @default("OSM")
  versionProveedor   String         @default("1.0") @map("version_proveedor")
  latInicio          Float?         @map("lat_inicio")
  lngInicio          Float?         @map("lng_inicio")
  latFin             Float?         @map("lat_fin")
  lngFin             Float?         @map("lng_fin")
  geometriaGeojson   Json?          @map("geometria_geojson")
  confianza          Float          @default(100.0)
  datosCrudos        Json?          @map("datos_crudos")
  fechaCreacion      DateTime       @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime       @updatedAt @map("fecha_actualizacion")

  @@unique([calleNormalizada, comuna, proveedor])
  @@index([osmWayId])
  @@index([roadId])
  @@map("cache_segmentos_viales")
}

model ParadaColectivo {
  id               String         @id @default(cuid())
  lineaId          String
  nombre           String         // ej: "Plaza de Armas"
  latitud          Float
  longitud         Float
  orden            Int            @default(0)
  sentido          String         @default("ida") // "ida" | "vuelta"
  fechaCreacion    DateTime       @default(now())
  linea            LineaColectivo @relation(fields: [lineaId], references: [id], onDelete: Cascade)

  @@map("paradas_colectivo")
}

model ReservaAsiento {
  id                 String         @id @default(cuid())
  pasajeroId         String
  conductorId        String
  lineaId            String
  cantidadAsientos   Int            @default(1)
  latitudSubida      Float?
  longitudSubida     Float?
  direccionSubida    String?
  estado             String         @default("reservado") // "reservado", "abordado", "completado", "cancelado"
  tarifa             Int            @default(800)
  metodoPago         String         @default("efectivo") // "efectivo", "rutpay", "mercadopago"
  notas              String?
  fechaCreacion      DateTime       @default(now())
  fechaActualizacion DateTime       @updatedAt
  conductor          Driver         @relation("ConductorReservas", fields: [conductorId], references: [id], onDelete: Cascade)
  pasajero           User           @relation("PasajeroReservas", fields: [pasajeroId], references: [id], onDelete: Cascade)
  linea              LineaColectivo @relation(fields: [lineaId], references: [id], onDelete: Cascade)

  @@map("reservas_asiento")
}

model Trip {
  id              String    @id @default(cuid())
  passengerId     String
  driverId        String?
  originLat       Float
  originLng       Float
  originAddress   String
  destLat         Float
  destLng         Float
  destAddress     String
  distanceKm      Float
  durationMin     Int
  estimatedPrice  Int
  finalPrice      Int?
  isDiscounted    Boolean   @default(false)
  paymentMethod   String
  isPaid          Boolean   @default(false)
  paymentStatus   String    @default("pending")
  otpCode         String?
  mpPaymentId     String?
  status          String    @default("searching")
  cancelledBy     String?
  cancelReason    String?
  requestedAt     DateTime  @default(now())
  acceptedAt      DateTime?
  driverArrivedAt DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  rating          Rating?
  driver          Driver?   @relation("DriverTrips", fields: [driverId], references: [id])
  passenger       User      @relation("PassengerTrips", fields: [passengerId], references: [id])

  @@map("trips")
}

model Rating {
  id            String   @id @default(cuid())
  tripId        String   @unique
  passengerId   String
  driverId      String
  driverScore   Int
  driverComment String?
  createdAt     DateTime @default(now())
  driver        Driver   @relation("DriverRatings", fields: [driverId], references: [id])
  passenger     User     @relation("PassengerRatings", fields: [passengerId], references: [id])
  trip          Trip     @relation(fields: [tripId], references: [id])

  @@map("ratings")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String?
  driverId  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Payout {
  id         String   @id @default(cuid())
  driverId   String
  amount     Int
  status     String   @default("pending")
  receiptUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  driver     Driver   @relation(fields: [driverId], references: [id])

  @@map("payouts")
}
