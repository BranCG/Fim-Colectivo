{
  "name": "fim-colectivo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\" \"npm run dev --workspace=apps/admin\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run generate --workspace=packages/database",
    "db:migrate": "npm run migrate --workspace=packages/database",
    "db:seed": "npm run seed --workspace=packages/database",
    "db:studio": "npm run studio --workspace=packages/database",
    "mobile:sync": "npm run mobile:sync --workspace=@fim-colectivo/web",
    "mobile:open": "npm run mobile:open --workspace=@fim-colectivo/web",
    "docker:up": "docker compose up -d",
    "docker:build": "docker compose up -d --build",
    "docker:restart": "docker compose restart",
    "docker:logs": "docker compose logs -f",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@prisma/client": "^5.10.0",
    "concurrently": "^10.0.5",
    "prisma": "^5.10.0"
  }
}
